spring.application.name=clone

# 로컬 개발 시: 아래 값을 실제 DB 정보로 채운 뒤,
# 이 파일을 복사해서 파일명을 application.properties로 바꿔서 사용하세요.
# (application.properties는 .gitignore에 등록되어 있어 Git에 올라가지 않습니다.)

spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:mariadb://localhost:3306/bpoint?autoReconnect=true}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:root}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:여기에_본인_로컬_DB_비밀번호_입력}

spring.jpa.hibernate.ddl-auto=${SPRING_JPA_HIBERNATE_DDL_AUTO:update}
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MariaDBDialect

spring.mvc.view.prefix=/WEB-INF/views/
spring.mvc.view.suffix=.jsp